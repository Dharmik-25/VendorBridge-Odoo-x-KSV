# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/vendorbridge"

# ─── JWT ────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Email (Gmail SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# ─── Company Info (for PDF) ──────────────────────────────────
COMPANY_NAME=VendorBridge Inc.
COMPANY_ADDRESS=123 Main Street, Mumbai, India
COMPANY_EMAIL=info@vendorbridge.com
COMPANY_PHONE=+91-9876543210
COMPANY_GST=27ABCDE1234F1Z5
