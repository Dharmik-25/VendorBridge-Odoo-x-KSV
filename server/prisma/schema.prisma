// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  procurement_officer
  manager
  vendor
}

enum VendorStatus {
  pending
  approved
  rejected
  suspended
}

enum RFQStatus {
  draft
  published
  closed
  awarded
  cancelled
}

enum QuotationStatus {
  submitted
  under_review
  shortlisted
  approved
  rejected
  withdrawn
}

enum ApprovalStatus {
  pending
  approved
  rejected
  escalated
}

enum POStatus {
  generated
  acknowledged
  fulfilled
  cancelled
}

enum InvoiceStatus {
  draft
  issued
  paid
  overdue
  cancelled
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash")
  role         UserRole @default(vendor)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  vendor        Vendor?
  rfqs          RFQ[]
  approvals     Approval[]        @relation("ApproverApprovals")
  purchaseOrders PurchaseOrder[]  @relation("CreatedByUser")
  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Vendor {
  id        String       @id @default(uuid())
  userId    String?      @unique @map("user_id")
  name      String       @db.VarChar(150)
  email     String       @unique @db.VarChar(150)
  phone     String?      @db.VarChar(20)
  category  String?      @db.VarChar(100)
  gstNumber String?      @unique @map("gst_number") @db.VarChar(20)
  country   String       @default("India") @db.VarChar(100)
  status    VendorStatus @default(pending)
  rating    Decimal      @default(0.00) @db.Decimal(3, 2)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  rfqVendors     RFQVendor[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model RFQ {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(200)
  description String?
  deadline    DateTime
  status      RFQStatus @default(draft)
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy      User            @relation(fields: [createdById], references: [id])
  items          RFQItem[]
  rfqVendors     RFQVendor[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@map("rfqs")
}

model RFQItem {
  id             String  @id @default(uuid())
  rfqId          String  @map("rfq_id")
  productName    String  @map("product_name") @db.VarChar(200)
  quantity       Decimal @db.Decimal(10, 2)
  unit           String  @default("pcs") @db.VarChar(50)
  specifications String?

  rfq             RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotationItems  QuotationItem[]

  @@map("rfq_items")
}

model RFQVendor {
  id         String   @id @default(uuid())
  rfqId      String   @map("rfq_id")
  vendorId   String   @map("vendor_id")
  invitedAt  DateTime @default(now()) @map("invited_at")
  notified   Boolean  @default(false)

  rfq    RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
  @@map("rfq_vendors")
}

model Quotation {
  id            String          @id @default(uuid())
  rfqId         String          @map("rfq_id")
  vendorId      String          @map("vendor_id")
  notes         String?
  deliveryDays  Int             @map("delivery_days")
  status        QuotationStatus @default(submitted)
  weightedScore Decimal?        @map("weighted_score") @db.Decimal(5, 2)
  submittedAt   DateTime        @default(now()) @map("submitted_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  rfq             RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  items           QuotationItem[]
  approvals       Approval[]
  purchaseOrders  PurchaseOrder[]

  @@unique([rfqId, vendorId])
  @@map("quotations")
}

model QuotationItem {
  id           String  @id @default(uuid())
  quotationId  String  @map("quotation_id")
  rfqItemId    String  @map("rfq_item_id")
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem   RFQItem   @relation(fields: [rfqItemId], references: [id])

  @@unique([quotationId, rfqItemId])
  @@map("quotation_items")
}

model Approval {
  id          String         @id @default(uuid())
  quotationId String         @map("quotation_id")
  approverId  String         @map("approver_id")
  status      ApprovalStatus @default(pending)
  remarks     String?
  decidedAt   DateTime?      @map("decided_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approver  User      @relation("ApproverApprovals", fields: [approverId], references: [id])

  @@map("approvals")
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  rfqId       String   @map("rfq_id")
  quotationId String   @map("quotation_id")
  poNumber    String   @unique @map("po_number") @db.VarChar(50)
  vendorId    String   @map("vendor_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal  Decimal  @map("grand_total") @db.Decimal(14, 2)
  status      POStatus @default(generated)
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  rfq       RFQ       @relation(fields: [rfqId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  createdBy User      @relation("CreatedByUser", fields: [createdById], references: [id])
  items     POItem[]
  invoice   Invoice?

  @@map("purchase_orders")
}

model POItem {
  id          String  @id @default(uuid())
  poId        String  @map("po_id")
  productName String  @map("product_name") @db.VarChar(200)
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@map("po_items")
}

model Invoice {
  id            String        @id @default(uuid())
  poId          String        @unique @map("po_id")
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime      @map("due_date")
  status        InvoiceStatus @default(draft)
  pdfPath       String?       @map("pdf_path")
  emailedAt     DateTime?     @map("emailed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])

  @@map("invoices")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
